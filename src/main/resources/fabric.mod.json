{
	"schemaVersion": 1,
	"id": "immersiveenchanting",
	"version": "${version}",
	"name": "Immersive Enchanting",
	"description": "Overhauls the Minecraft enchanting system to be more visual, engaging, and immersive.",
	"authors": [
		"tnpl"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/DmytroChup/immersive-enchanting"
	},
	"license": "MIT",
	"icon": "assets/immersiveenchanting/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"tnpl.immersiveenchanting.ImmersiveEnchanting"
		],
		"client": [
			"tnpl.immersiveenchanting.client.ImmersiveEnchantingClient"
		]
	},
	"mixins": [
		"immersiveenchanting.mixins.json",
		{
			"config": "immersiveenchanting.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.152.1"
	}
}